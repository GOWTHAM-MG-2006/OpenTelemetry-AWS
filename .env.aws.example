# .env.aws.example — AWS browse-slice defaults (EXAMPLE ONLY, no real secrets).
# Copy to .env.aws and fill in the CHANGE_ME / <...> placeholders at deploy
# time (todo 13 transfers the real file to EC2; it is never committed).
# Validated with: docker compose -f compose.aws.yaml --env-file .env.aws.example config --quiet

# --- Image tags (pinned :aws-<date> convention, recorded 2026-09-20) ---
AWS_IMAGE_TAG=aws-2026-09-20

# --- Service ports (defaults match each Dockerfile ARG/EXPOSE) ---
FRONTEND_PORT=8080
PRODUCT_CATALOG_PORT=3550
RECOMMENDATION_PORT=9001
CURRENCY_PORT=7001
# Cart serves gRPC on CART_PORT (Program.cs honors ASPNETCORE_URLS; no :8080
# hardcode exists in src/cart) — default 7070 matches its Dockerfile EXPOSE.
CART_PORT=7070
VALKEY_PORT=6379
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016

# --- Feature flags ---
FLAGD_HOST=flagd

# --- Cart state (box-local Valkey; Railway Redis is fallback-only, unwired) ---
VALKEY_ADDR=valkey:6379

# --- Product data (Railway Postgres, injected at deploy — NEVER commit real URL) ---
# Format from todo-2 proof; password replaced with CHANGE_ME here.
DB_CONNECTION_STRING=postgres://astronomy_user:CHANGE_ME@<railway-host>:<port>/astronomy_db?sslmode=require
